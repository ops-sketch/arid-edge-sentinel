# NASA Earthdata Login — get one free at https://urs.earthdata.nasa.gov
# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit your real password.

EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here

# Optional defaults — Sahel bounding box (lon_min, lat_min, lon_max, lat_max)
DEFAULT_BBOX=-5,12,20,18
DEFAULT_DAYS_BACK=14
